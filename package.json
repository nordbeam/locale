{
  "name": "@nordbeam/locale",
  "version": "0.3.0",
  "description": "Nordbeam Locale: compile ICU translations into typed, tree-shakable JavaScript with lazy locale loading",
  "keywords": [
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "icu",
    "messageformat",
    "translations",
    "typescript",
    "typed",
    "tree-shaking",
    "vite",
    "react",
    "nextjs",
    "vue",
    "svelte",
    "solid"
  ],
  "license": "Apache-2.0",
  "author": "Nordbeam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordbeam/locale.git"
  },
  "bugs": {
    "url": "https://github.com/nordbeam/locale/issues"
  },
  "homepage": "https://github.com/nordbeam/locale#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "!skills/*/evals",
    "NOTICE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "nordbeam-locale": "./dist/cli.js",
    "nordbeam-locale-mcp": "./dist/mcp-bin.js",
    "nordbeam-i18n": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./translations": {
      "types": "./dist/translations.d.ts",
      "import": "./dist/translations.js"
    },
    "./po": {
      "types": "./dist/po.d.ts",
      "import": "./dist/po.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/rich": {
      "types": "./dist/react-rich.d.ts",
      "import": "./dist/react-rich.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./next/runtime": {
      "types": "./dist/next-runtime.d.ts",
      "import": "./dist/next-runtime.js"
    },
    "./next/middleware": {
      "types": "./dist/next-middleware.d.ts",
      "import": "./dist/next-middleware.js"
    },
    "./next/navigation": {
      "types": "./dist/next-navigation.d.ts",
      "import": "./dist/next-navigation.js"
    },
    "./next/routing": {
      "types": "./dist/next-routing.d.ts",
      "import": "./dist/next-routing.js"
    },
    "./next/server": {
      "types": "./dist/next-server.d.ts",
      "import": "./dist/next-server.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start.d.ts",
      "import": "./dist/tanstack-start.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./internal/migrate": {
      "types": "./dist/migrate-support.d.ts",
      "import": "./dist/migrate-support.js"
    },
    "./pseudo": {
      "types": "./dist/pseudo.d.ts",
      "import": "./dist/pseudo.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./agent/plans": {
      "types": "./dist/agent/plans.d.ts",
      "import": "./dist/agent/plans.js"
    },
    "./agent/events": {
      "types": "./dist/agent/events.d.ts",
      "import": "./dist/agent/events.js"
    },
    "./agent/inspect": {
      "types": "./dist/agent/inspect.d.ts",
      "import": "./dist/agent/inspect.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.168.0",
    "@tanstack/react-start": ">=1.168.0",
    "next": ">=13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"for (const dir of ['dist', 'packages/locale-migrate/dist']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p packages/locale-migrate/tsconfig.json",
    "test": "npm run build && node --test --test-timeout=120000 test/*.test.mjs && node --conditions=browser --test test/solid-client.test.mjs test/tanstack-start-client.test.mjs",
    "check": "npm test && npm run example:build && npm run react:check && npm run next:check && npm run next:rtl:check && npm run next:advanced:check && npm run next:advanced:check:webpack && npm run tanstack-start:check",
    "prepack": "npm run build",
    "dev": "npm run build && vite --config examples/vite/vite.config.ts",
    "example:build": "npm run build && vite build --config examples/vite/vite.config.ts",
    "react:dev": "npm run build && node examples/react/server.mjs",
    "react:build": "npm run build && vite build --config examples/react/vite.config.ts && vite build --config examples/react/vite.config.ts --ssr src/entry-server.tsx && tsc -p examples/react/tsconfig.json",
    "react:serve": "node examples/react/server.mjs --production",
    "react:check": "npm run react:build && node test/integration/react.mjs",
    "next:check": "npm run build && node test/integration/next.mjs",
    "next:check:webpack": "npm run build && node test/integration/next.mjs --webpack",
    "next:rtl:check": "npm run build && node test/integration/next-rtl.mjs",
    "next:check:edge": "npm run build && node test/integration/next-edge-runtime.mjs",
    "next:advanced:check": "npm run build && node test/integration/next-advanced.mjs",
    "next:advanced:check:webpack": "npm run build && node test/integration/next-advanced.mjs --webpack",
    "tanstack-start:check": "npm run build && node test/integration/tanstack-start.mjs",
    "vscode:build": "npm --prefix editors/vscode run build",
    "vscode:test": "npm --prefix editors/vscode run test",
    "vscode:check": "npm run vscode:build && npm run vscode:test"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@inlang/paraglide-js": "2.25.0",
    "@inlang/sdk": "3.0.3",
    "@lingui/core": "6.6.0",
    "@lingui/message-utils": "6.6.0",
    "@lingui/react": "6.6.0",
    "@messageformat/core": "3.4.0",
    "@nordbeam/locale": "file:.",
    "@nordbeam/locale-migrate": "file:packages/locale-migrate",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "@tolgee/core": "7.2.0",
    "@tolgee/format-icu": "7.2.0",
    "@types/gettext-parser": "9.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/vscode": "1.103.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/server-renderer": "3.5.42",
    "esbuild": "0.28.2",
    "frenchkiss": "0.4.0",
    "i18next": "26.4.2",
    "i18next-icu": "2.4.4",
    "intl-messageformat": "11.2.14",
    "jsdom": "27.4.0",
    "next": "16.3.4",
    "next-i18next": "16.3.0",
    "next-international": "1.3.1",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-intl": "10.1.26",
    "react-server-dom-webpack": "19.2.8",
    "solid-js": "1.9.17",
    "srvx": "1.0.5",
    "svelte": "5.56.10",
    "svelte-i18n": "4.0.1",
    "typesafe-i18n": "5.27.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "vue-i18n": "11.4.8"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "magic-string": "1.4.3"
  }
}
